# Firebase console > Authentication: enable Google and Email/Password, and Phone (add test numbers
# for the demo). Add your dev and hosting domains under Authorized domains.
VITE_FIREBASE_API_KEY=changeme
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=changeme
# Empty in dev (Vite proxies /api). Set to the API URL in production builds.
VITE_API_BASE_URL=
# Voice service WebSocket for the /call widget
# Leave empty in dev: the page uses its own origin and Vite proxies /browser to the voice service,
# so one HTTPS tunnel is enough on a phone (also set VITE_ALLOWED_HOSTS=<tunnel host> when
# starting npm run dev, and add the tunnel URL to BROWSER_ALLOWED_ORIGINS in voice/.env).
# Set it only when the voice service is deployed elsewhere, e.g. wss://residue-voice-xxxx.a.run.app/browser
# VITE_VOICE_WS_URL=

# Farmers confirm their phone by SMS only when true. Off: the phone is optional and unverified.
VITE_REQUIRE_VERIFIED_PHONE=false

# true = talk to the local Firebase emulators (set by `npm run e2e`; never for a real project)
VITE_FIREBASE_EMULATORS=false
