# Firebase console > Authentication: enable Google and Email/Password, and Phone (add test numbers
# for the demo). Add your dev and hosting domains under Authorized domains.
VITE_FIREBASE_API_KEY=changeme
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=changeme
# Empty in dev (Vite proxies /api). Set to the API URL in production builds.
VITE_API_BASE_URL=
# Voice service WebSocket for the /call widget
VITE_VOICE_WS_URL=ws://localhost:8001/browser

# Farmers confirm their phone by SMS only when true. Off: the phone is optional and unverified.
VITE_REQUIRE_VERIFIED_PHONE=false
