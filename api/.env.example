GOOGLE_CLOUD_PROJECT=your-gcp-project
FIREBASE_PROJECT_ID=your-firebase-project
# Service account email of the voice service (allowed to call /api/agent/*)
VOICE_SERVICE_ACCOUNT=residue-voice@your-gcp-project.iam.gserviceaccount.com
# Expected audience of Google ID tokens (the API's Cloud Run URL)
API_AUDIENCE=https://residue-api-xxxx.a.run.app
GEMINI_API_KEY=changeme
# Local dev / tests / Swagger only: skip token checks (dashboards read X-Dev-Uid, X-Dev-Email,
# X-Dev-Phone). The web app never uses this. Ignored whenever K_SERVICE is set (Cloud Run).
AUTH_DISABLED=false
# Comma list of emails that become admin on first sign-in (the email must be verified, e.g. Google).
BOOTSTRAP_ADMIN_EMAILS=
# Seconds a token may look issued in the future (clock drift on this machine). Default 60.
AUTH_CLOCK_SKEW_SECONDS=60
# Origins allowed to call the API from a browser (the deployed web app). Empty = no CORS.
CORS_ORIGINS=
# PostgreSQL: local install, optional `docker compose up -d db`, Neon, or Cloud SQL.
# Create the database first (see api/README.md).
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/residue
# Firestore is used only for the `events` feed (refetch signal).
FIRESTORE_EMULATOR_HOST=localhost:8080

# Money model (basis points; the farmer gets the remainder). See memory/backend-flows.md.
SHARE_TRANSPORTER_BPS=2000
SHARE_PLATFORM_BPS=1000
# Product sale split (must sum to 10000)
SALE_SHARE_FARMER_BPS=5000
SALE_SHARE_FACTORY_BPS=3000
SALE_SHARE_NGO_BPS=500
SALE_SHARE_PLATFORM_BPS=1500
# Local stand-in for Cloud Scheduler: advance lapsed offers every N seconds (0 = off). Never on Cloud Run.
DISPATCH_LOOP_SECONDS=5
# Seconds a transporter has to accept an offer (raise it for demos)
OFFER_TTL_SECONDS=120
# Cloud Scheduler service account allowed to call POST /api/dispatch/tick
SCHEDULER_SERVICE_ACCOUNT=
# Photos: set a bucket to use Cloud Storage; empty uses a fake store for local dev
STORAGE_BUCKET=
# Visual grading model (needs GEMINI_API_KEY)
GRADING_MODEL=gemini-2.5-flash
# 1 = write the Firestore events feed (refetch signals for dashboards); 0 or empty = off
FIRESTORE_EVENTS=

# true = a farmer must verify their phone by SMS before reporting (always on Cloud Run)
REQUIRE_VERIFIED_PHONE=false
