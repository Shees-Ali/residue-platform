GOOGLE_CLOUD_PROJECT=your-gcp-project
FIREBASE_PROJECT_ID=your-firebase-project
# Service account email of the voice service (allowed to call /api/agent/*)
VOICE_SERVICE_ACCOUNT=residue-voice@your-gcp-project.iam.gserviceaccount.com
# Expected audience of Google ID tokens (the API's Cloud Run URL)
API_AUDIENCE=https://residue-api-xxxx.a.run.app
GEMINI_API_KEY=changeme
# PostgreSQL: local install, optional `docker compose up -d db`, Neon, or Cloud SQL.
# Create the database first (see api/README.md).
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/residue
# Firestore is used only for the `events` feed (refetch signal).
FIRESTORE_EMULATOR_HOST=localhost:8080
