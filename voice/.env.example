# URL of the API Cloud Run service; also the audience of the Google ID token
API_BASE_URL=http://localhost:8000
# Local dev: skip ID token minting (never in Cloud Run)
API_AUTH_DISABLED=true
GEMINI_API_KEY=changeme
TWILIO_AUTH_TOKEN=changeme
# Public https URL Twilio calls (used for signature validation and the media stream URL)
PUBLIC_BASE_URL=https://your-voice-service.a.run.app
