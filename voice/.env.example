# URL of the API Cloud Run service; also the audience of the Google ID token
API_BASE_URL=http://localhost:8000
# Local dev: skip ID token minting (never in Cloud Run)
API_AUTH_DISABLED=true
GEMINI_API_KEY=changeme
# Browser mic fallback (/browser on the /call page): unauthenticated, so local/demo only.
# Set true locally; never on a public deployment. Comma-separated exact page origins.
BROWSER_CALLS_ENABLED=false
BROWSER_ALLOWED_ORIGINS=http://localhost:5173
# Calls one IP may place per 10 minutes on the public /phone page (0 = no limit)
BROWSER_CALLS_PER_IP=3
# Telnyx Call Control (Mission Control: API key; Keys & Credentials > Public Key, base64)
TELNYX_API_KEY=changeme
TELNYX_PUBLIC_KEY=changeme
# Signs per-call media stream URLs; set the same random value on the API (openssl rand -hex 32)
STREAM_SECRET=changeme
# Public https URL of this service; Telnyx streams call audio to <this>/telnyx/media
PUBLIC_BASE_URL=https://your-voice-service.a.run.app
# Optional: text models for the live transcript's Roman Urdu, tried in order (comma-separated)
# ROMAN_URDU_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.1-flash-lite
